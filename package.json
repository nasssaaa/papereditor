{
  "name": "papereditor",
  "version": "0.1.0",
  "private": true,
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "server": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write client server shared tests *.ts *.json index.html",
    "admin": "tsx server/admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.3",
    "@monaco-editor/react": "^4.7.0",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "fflate": "^0.8.2",
    "lib0": "^0.2.110",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.2",
    "y-indexeddb": "^9.0.12",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.6",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.27",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "prettier": "^3.6.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
