HOST=127.0.0.1
PORT=18080
DATA_DIR=.data
COMPILE_BACKEND=native
LATEXMK_BIN=latexmk
SYNCTEX_BIN=synctex
# On Windows, add a Perl directory for MiKTeX's latexmk wrapper.
# Run python deploy/install-perl-windows.py; the portable Perl is detected automatically.
# TEX_EXTRA_PATH=D:\\Tools\\strawberry\\perl\\bin
# Production on Mac uses native ARM TeX Live with a macOS sandbox:
# COMPILE_BACKEND=macos-sandbox
# DOCKER_BIN=/Applications/Docker.app/Contents/Resources/bin/docker
# TEXLIVE_DIR=/Volumes/KIOXIA/PaperEditor/texlive
# REQUIRED_VOLUME=/Volumes/KIOXIA
COMPILE_TIMEOUT_MS=120000
COMPILE_CONCURRENCY=1
# HTTP is for the explicitly selected private beta; enable with HTTPS.
COOKIE_SECURE=false
